 IMAGE = "sdebench-base"
 
 
+def _reclaim(path):
+    """LOCAL PATCH (Linux Docker): containers run as root and leave root-owned files (pyc,
+    .pytest_cache) in bind mounts; hand them back to the host user before deleting."""
+    path = Path(path)
+    if path.exists():
+        subprocess.run(["docker", "run", "--rm", "-v", f"{path}:/x", IMAGE, "chown", "-R",
+                        f"{os.getuid()}:{os.getgid()}", "/x"], capture_output=True)
+
+
