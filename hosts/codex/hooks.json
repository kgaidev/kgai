{
  "description": "kgai lifecycle hooks for Codex CLI. Same three jobs as the Claude Code manifest — install the engine and hand the model this repo's capture rules at session start, sync with the team remote in the background, and force the capture decision at end of turn — wired to Codex's event names and tool names.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/session-start.sh\"",
            "timeout": 180,
            "statusMessage": "kgai: preparing the decision graph"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^(apply_patch|shell|local_shell|unified_exec|exec_command|write_file|edit_file|create_file|str_replace|update_file)$",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/turn-state.sh\"",
            "timeout": 10,
            "async": false
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/auto-capture-stop.sh\"",
            "timeout": 20
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/auto-sync.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/auto-sync.sh\"",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
